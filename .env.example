# Copie este arquivo para ".env" (na pasta do site) e ajuste: o site lê o .env sozinho ao ligar
# (o que já estiver definido no sistema vale mais). O .env não é apagado pelas atualizações.
# Porta do site (na VPS sem Nginx/IIS na frente, use 80 para a Cloudflare encontrar o site)
PORT=3000
# Senha inicial do painel /admin (usada só se ainda não existir senha). Obrigatória na VPS.
ADMIN_PASSWORD=
# Pasta onde fica o banco de dados (padrão: ./data)
# DATA_DIR=./data
# Defina 1 para subir o site sem o minerador automático
# DISABLE_MINER=0

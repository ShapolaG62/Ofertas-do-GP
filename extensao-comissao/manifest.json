{
  "manifest_version": 3,
  "name": "Ofertou! Mercado Livre",
  "short_name": "Ofertou ML",
  "version": "2.13.0",
  "description": "Leva do Mercado Livre para o Ofertou! as ofertas relâmpago, os cupons, os produtos com comissão extra, além do saldo e das vendas de afiliado do Mercado Livre e da Magalu, sem copiar e colar.",
  "icons": {
    "16": "icone.png",
    "48": "icone.png",
    "128": "icone.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://lista.mercadolivre.com.br/*",
    "https://www.mercadolivre.com.br/*",
    "https://rochelle.magazinevoce.com.br/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.mercadolivre.com.br/afiliados*"
      ],
      "js": [
        "mercadolivre.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.mercadolivre.com.br/ofertas*"
      ],
      "js": [
        "ofertas.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.mercadolivre.com.br/cupons*"
      ],
      "js": [
        "cupons.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tanoofertou.com.br/cliente*",
        "https://www.tanoofertou.com.br/cliente*",
        "http://localhost/cliente*",
        "http://127.0.0.1/cliente*"
      ],
      "js": [
        "painel-cliente.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://tanoofertou.com.br/admin*",
        "https://www.tanoofertou.com.br/admin*",
        "http://localhost/admin*",
        "http://127.0.0.1/admin*"
      ],
      "js": [
        "painel.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}

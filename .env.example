# Copie este arquivo para ".env" (opcional) ou defina as variáveis no servidor.
# Porta do site
PORT=3000
# Senha inicial do painel /admin (usada só se ainda não existir senha). Obrigatória na VPS.
ADMIN_PASSWORD=
# Pasta onde fica o banco de dados (padrão: ./data)
# DATA_DIR=./data
# Defina 1 para subir o site sem o minerador automático
# DISABLE_MINER=0

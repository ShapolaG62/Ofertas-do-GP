{
  "manifest_version": 3,
  "name": "Ofertou! Mercado Livre",
  "short_name": "Ofertou ML",
  "version": "2.8.0",
  "description": "Leva para o Painel do Ofertou! os produtos com comissão extra, o ganho estimado do seu painel de afiliado e os cupons do Mercado Livre (com os produtos em que valem), sem copiar e colar.",
  "icons": {
    "16": "icone.png",
    "48": "icone.png",
    "128": "icone.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.mercadolivre.com.br/afiliados*"
      ],
      "js": [
        "mercadolivre.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.mercadolivre.com.br/cupons*",
        "https://lista.mercadolivre.com.br/*"
      ],
      "js": [
        "cupons.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tanoofertou.com.br/cliente*",
        "https://www.tanoofertou.com.br/cliente*",
        "http://localhost/cliente*",
        "http://127.0.0.1/cliente*"
      ],
      "js": [
        "painel-cliente.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://tanoofertou.com.br/admin*",
        "https://www.tanoofertou.com.br/admin*",
        "http://localhost/admin*",
        "http://127.0.0.1/admin*"
      ],
      "js": [
        "painel.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}

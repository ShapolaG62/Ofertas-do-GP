{
  "name": "ofertas-do-gp",
  "version": "1.0.0",
  "description": "Plataforma completa de mineração de ofertas em tempo real - Ofertas do GP",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:vps": "pm2 start ecosystem.config.js",
    "stop:vps": "pm2 stop ofertas-do-gp",
    "logs": "pm2 logs ofertas-do-gp",
    "mine": "node -e \"require('./miner').mineAll()\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "sqlite3": "^5.1.7"
  }
}
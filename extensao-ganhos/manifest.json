{
  "manifest_version": 3,
  "name": "Ofertou! Ganhos",
  "short_name": "Ofertou Ganhos",
  "version": "1.2.0",
  "description": "Sincroniza sozinho, em segundo plano, o saldo dos seus programas de afiliados (Mercado Livre, Amazon, Magalu, Shopee, AliExpress e Awin) com o painel do Ofertou!.",
  "icons": {
    "16": "icone.png",
    "48": "icone.png",
    "128": "icone.png"
  },
  "action": {
    "default_title": "Ofertou! Ganhos",
    "default_popup": "popup.html",
    "default_icon": "icone.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://tanoofertou.com.br/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.mercadolivre.com.br/afiliados*",
        "https://associados.amazon.com.br/*",
        "https://affiliate.shopee.com.br/*",
        "https://www.parceiromagalu.com.br/*",
        "https://parceiromagalu.com.br/*",
        "https://*.parceiromagalu.com.br/*",
        "https://portals.aliexpress.com/*",
        "https://ui.awin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://produto.mercadolivre.com.br/*",
        "https://www.mercadolivre.com.br/*/p/*",
        "https://www.mercadolivre.com.br/p/*",
        "https://www.mercadolivre.com.br/*MLB*"
      ],
      "exclude_matches": [
        "https://www.mercadolivre.com.br/afiliados*"
      ],
      "js": [
        "content-ml.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
